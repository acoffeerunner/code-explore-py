# =============================================================================
# Code Explorer - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Supabase Configuration (Required)
# =============================================================================
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe to expose client-side)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (KEEP SECRET - server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase JWT secret (for verifying auth tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# PostgreSQL connection URL (use pooler connection string from Supabase)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# =============================================================================
# Redis Configuration (Required)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Pinecone Configuration (Required)
# =============================================================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=code-explorer
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# =============================================================================
# OpenAI Configuration (Required)
# =============================================================================
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
DEFAULT_CHAT_MODEL=gpt-4o-mini

# =============================================================================
# RAG Pipeline Configuration
# =============================================================================
RERANKER_MODEL=gpt-4o-mini
HYDE_MODEL=gpt-4o-mini
HYDE_ENABLED=true
RERANKER_ENABLED=true
MIN_SIMILARITY_SCORE=0.3
CHAT_HISTORY_TURNS=5

# =============================================================================
# Git Configuration (Optional)
# =============================================================================
GIT_CLONE_TIMEOUT=120
MAX_REPO_SIZE_MB=250
CLONE_BASE_PATH=/tmp/repos
# Comma-separated list of allowed Git hosts
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org

# =============================================================================
# Rate Limiting Configuration (Optional)
# =============================================================================
# Per-user rate limit (authenticated requests)
RATE_LIMIT_PER_USER=100
# Per-IP rate limit (abuse prevention)
RATE_LIMIT_PER_IP=1000
# Window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Security Configuration (Optional)
# =============================================================================
# Number of trusted reverse proxies (for X-Forwarded-For parsing)
# Set to 1 if behind a single load balancer, 0 if direct connections
TRUSTED_PROXY_COUNT=0

# =============================================================================
# Webhook Configuration (Optional)
# =============================================================================
WEBHOOK_MAX_RETRIES=6
WEBHOOK_RETRY_WINDOW_HOURS=1

# =============================================================================
# Garbage Collection Configuration (Optional)
# =============================================================================
# Hours to keep stale index versions before cleanup
STALE_VERSION_TTL_HOURS=1

# =============================================================================
# LangSmith Configuration (Optional - LLM Observability)
# =============================================================================
# LangSmith API key (leave empty to disable LLM tracing)
LANGSMITH_API_KEY=
# LangSmith project name
LANGSMITH_PROJECT=code-explorer

# =============================================================================
# Observability Configuration (Optional)
# =============================================================================
# OpenTelemetry OTLP endpoint (leave empty to disable)
OTLP_ENDPOINT=
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log format: json (production) or console (development)
LOG_FORMAT=json
